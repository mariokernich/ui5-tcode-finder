{
	"name": "de.kernich.tcode",
	"version": "1.3.0",
	"private": true,
	"description": "T-Code Quick Finder - search, copy and manage SAP transaction codes",
	"author": "Mario Kernich",
	"license": "Apache-2.0",
	"homepage": "https://tcodes.kernich.de",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mariokernich/ui5-tcode-finder.git"
	},
	"engines": {
		"node": "^22.13.0 || >=24"
	},
	"scripts": {
		"clean": "rimraf dist coverage report",
		"build": "ui5 build self-contained --all --include-task generateVersionInfo --exclude-task replaceBuildtime --clean-dest && node scripts/prune-build.mjs && node scripts/generate-service-worker.mjs",
		"start": "ui5 serve --port 8080 -o index.html",
		"start:coverage": "ui5 serve --port 8080 --config ui5-coverage.yaml",
		"start:dist": "ui5 serve --port 8090 -o index.html --config ui5-dist.yaml",
		"typecheck": "tsc",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"ui5lint": "ui5lint",
		"test:runner": "ui5-test-runner --url http://localhost:8080/test/testsuite.qunit.html",
		"test:ui5": "ui5-test-runner --start start:coverage --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 60 -ccf 60 -ccl 60 -ccs 60",
		"test": "npm run lint && npm run typecheck && npm run ui5lint && npm run test:ui5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@openui5/types": "~1.148.9",
		"@ui5/cli": "^4.0.70",
		"@ui5/linter": "^1.23.7",
		"babel-plugin-istanbul": "^8.0.0",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"ui5-middleware-livereload": "^3.4.0",
		"ui5-test-runner": "^5.14.1",
		"ui5-tooling-transpile": "^3.13.1"
	}
}
