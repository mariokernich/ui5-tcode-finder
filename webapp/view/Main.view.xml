<mvc:View
	controllerName="de.kernich.tcode.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatMessage: 'sap/base/strings/formatMessage'
	}"
>
	<Page
		id="page"
		showFooter="{= ${view>/selectedGroup} === 'CUSTOM' }"
		busy="{view>/busy}"
		busyIndicatorDelay="0"
	>
		<customHeader>
			<core:Fragment
				fragmentName="de.kernich.tcode.view.fragments.Header"
				type="XML"
			/>
		</customHeader>
		<content>
			<IconTabBar
				id="groupTabBar"
				selectedKey="{view>/selectedGroup}"
				select=".onGroupSelect"
				applyContentPadding="false"
				headerMode="Inline"
				upperCase="true"
			>
				<items>
					<IconTabFilter
						key="ALL"
						icon="sap-icon://multiselect-all"
						text="{ parts: ['i18n>groupTab', 'i18n>group.ALL', 'view>/counts/ALL'], formatter: 'formatMessage' }"
					/>
					<IconTabFilter
						key="GENERAL"
						icon="sap-icon://world"
						text="{ parts: ['i18n>groupTab', 'i18n>group.GENERAL', 'view>/counts/GENERAL'], formatter: 'formatMessage' }"
						visible="{view>/groupVisible/GENERAL}"
					/>
					<IconTabFilter
						key="UI5"
						icon="sap-icon://popup-window"
						text="{ parts: ['i18n>groupTab', 'i18n>group.UI5', 'view>/counts/UI5'], formatter: 'formatMessage' }"
						visible="{view>/groupVisible/UI5}"
					/>
					<IconTabFilter
						key="ABAP"
						icon="sap-icon://syntax"
						text="{ parts: ['i18n>groupTab', 'i18n>group.ABAP', 'view>/counts/ABAP'], formatter: 'formatMessage' }"
						visible="{view>/groupVisible/ABAP}"
					/>
					<IconTabFilter
						key="EWM"
						icon="sap-icon://business-objects-explorer"
						text="{ parts: ['i18n>groupTab', 'i18n>group.EWM', 'view>/counts/EWM'], formatter: 'formatMessage' }"
						visible="{view>/groupVisible/EWM}"
					/>
					<IconTabFilter
						key="ERP"
						icon="sap-icon://factory"
						text="{ parts: ['i18n>groupTab', 'i18n>group.ERP', 'view>/counts/ERP'], formatter: 'formatMessage' }"
						visible="{view>/groupVisible/ERP}"
					/>
					<IconTabFilter
						key="FI"
						icon="sap-icon://money-bills"
						text="{ parts: ['i18n>groupTab', 'i18n>group.FI', 'view>/counts/FI'], formatter: 'formatMessage' }"
						visible="{view>/groupVisible/FI}"
					/>
					<IconTabFilter
						key="CUSTOM"
						icon="sap-icon://wrench"
						text="{ parts: ['i18n>groupTab', 'i18n>group.CUSTOM', 'view>/counts/CUSTOM'], formatter: 'formatMessage' }"
						visible="{view>/groupVisible/CUSTOM}"
					/>
				</items>
			</IconTabBar>
			<Table
				id="transactionTable"
				items="{
					path: '/',
					sorter: [
						{ path: 'favorite', descending: true },
						{ path: 'tcode' }
					]
				}"
				mode="{= ${view>/selectedGroup} === 'CUSTOM' ? 'MultiSelect' : 'None' }"
				itemPress=".onItemPress"
				selectionChange=".onSelectionChange"
				beforeOpenContextMenu=".onBeforeOpenContextMenu"
				noDataText="{i18n>tableNoData}"
				sticky="ColumnHeaders"
			>
				<contextMenu>
					<Menu>
						<MenuItem
							text="{i18n>editTransaction}"
							icon="sap-icon://edit"
							press=".onEditTransaction"
						/>
					</Menu>
				</contextMenu>
				<columns>
					<Column width="{= ${device>/system/desktop} ? '14rem' : 'auto' }">
						<Text text="{i18n>columnTcode}" />
					</Column>
					<Column width="{= ${device>/system/desktop} ? '20rem' : 'auto' }">
						<Text text="{i18n>columnTitle}" />
					</Column>
					<Column visible="{device>/system/desktop}">
						<Text text="{i18n>columnDescription}" />
					</Column>
					<Column
						hAlign="End"
						width="4rem"
					/>
				</columns>
				<items>
					<ColumnListItem type="Active">
						<cells>
							<Text text="{tcode}" />
							<Text text="{title}" />
							<Text text="{description}" />
							<Button
								icon="{= ${favorite} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }"
								tooltip="{= ${favorite} ? ${i18n>favoriteRemove} : ${i18n>favoriteAdd} }"
								type="Transparent"
								press=".onToggleFavorite"
							/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button
					id="deleteButton"
					icon="sap-icon://delete"
					text="{i18n>deleteTransactions}"
					tooltip="{i18n>deleteTransactionsTooltip}"
					type="Reject"
					enabled="{= ${view>/selectedCount} > 0 }"
					press=".onDeleteTransactions"
				/>
				<Button
					icon="sap-icon://add-document"
					text="{i18n>newTransaction}"
					tooltip="{i18n>newTransactionTooltip}"
					type="Ghost"
					press=".onAddTransaction"
				/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
