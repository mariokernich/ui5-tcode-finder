<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
>
	<Dialog
		id="transactionDialog"
		title="{dialog>/heading}"
		contentWidth="30rem"
		draggable="true"
		afterOpen=".onTransactionDialogAfterOpen"
	>
		<content>
			<VBox class="sapUiSmallMargin">
				<Label
					text="{i18n>transactionCode}"
					labelFor="transactionCodeInput"
					required="true"
				/>
				<Input
					id="transactionCodeInput"
					value="{dialog>/tcode}"
					valueLiveUpdate="true"
					editable="{= ${dialog>/mode} === 'add' }"
					maxLength="20"
					placeholder="{i18n>transactionCodePlaceholder}"
					valueState="{dialog>/tcodeState}"
					valueStateText="{dialog>/tcodeStateText}"
					liveChange=".onTransactionCodeChange"
					submit=".onTransactionDialogSave"
					class="sapUiSmallMarginBottom"
				/>
				<Label
					text="{i18n>transactionTitle}"
					labelFor="transactionTitleInput"
				/>
				<Input
					id="transactionTitleInput"
					value="{dialog>/title}"
					valueLiveUpdate="true"
					placeholder="{i18n>transactionTitlePlaceholder}"
					submit=".onTransactionDialogSave"
					class="sapUiSmallMarginBottom"
				/>
				<Label
					text="{i18n>transactionDescription}"
					labelFor="transactionDescriptionInput"
				/>
				<Input
					id="transactionDescriptionInput"
					value="{dialog>/description}"
					valueLiveUpdate="true"
					placeholder="{i18n>transactionDescriptionPlaceholder}"
					submit=".onTransactionDialogSave"
				/>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{i18n>save}"
				icon="sap-icon://save"
				type="Emphasized"
				press=".onTransactionDialogSave"
			/>
		</beginButton>
		<endButton>
			<Button
				text="{i18n>cancel}"
				icon="sap-icon://decline"
				press=".onTransactionDialogCancel"
			/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
