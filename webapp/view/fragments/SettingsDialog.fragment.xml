<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:unified="sap.ui.unified"
>
	<Dialog
		id="settingsDialog"
		title="{i18n>settingsTitle}"
		contentWidth="36rem"
		draggable="true"
	>
		<content>
			<VBox class="sapUiSmallMargin">
				<Panel
					headerText="{i18n>settingsGeneral}"
					expandable="true"
					expanded="true"
				>
					<HBox alignItems="Center">
						<Label
							text="{i18n>settingsTheme}"
							labelFor="themeSelect"
							class="sapUiTinyMarginEnd"
						/>
						<Select
							id="themeSelect"
							selectedKey="{settings>/theme}"
						>
							<core:Item
								key="System"
								text="{i18n>themeSystem}"
							/>
							<core:Item
								key="Light"
								text="{i18n>themeLight}"
							/>
							<core:Item
								key="Dark"
								text="{i18n>themeDark}"
							/>
						</Select>
					</HBox>
				</Panel>
				<Panel
					id="copyBehaviorPanel"
					headerText="{i18n>settingsCopyBehavior}"
					expandable="true"
				>
					<VBox>
						<Label
							text="{i18n>settingsCopyBehaviorDescription}"
							labelFor="copyOptionGroup"
							wrapping="true"
						/>
						<RadioButtonGroup
							id="copyOptionGroup"
							selectedIndex="{settings>/copyOptionIndex}"
							select=".onCopyOptionSelect"
						>
							<RadioButton text="{i18n>copyOptionPlain}" />
							<RadioButton text="{i18n>copyOptionAuto}" />
							<RadioButton text="{i18n>copyOptionPrefixN}" />
							<RadioButton text="{i18n>copyOptionPrefixO}" />
							<RadioButton text="{i18n>copyOptionWebGui}" />
						</RadioButtonGroup>
						<Input
							id="sapSystemUrlInput"
							type="Url"
							width="100%"
							value="{settings>/sapSystemUrl}"
							valueLiveUpdate="true"
							visible="{settings>/webGuiSelected}"
							placeholder="{i18n>settingsSystemUrlPlaceholder}"
							ariaLabelledBy="sapSystemUrlLabel"
							valueState="{settings>/sapSystemUrlState}"
							valueStateText="{settings>/sapSystemUrlStateText}"
							liveChange=".onSystemUrlChange"
						/>
						<core:InvisibleText
							id="sapSystemUrlLabel"
							text="{i18n>settingsSystemUrl}"
						/>
						<CheckBox
							text="{i18n>settingsResetSearch}"
							selected="{settings>/resetSearchAfterCopy}"
							class="sapUiSmallMarginTop"
						/>
					</VBox>
				</Panel>
				<Panel
					headerText="{i18n>settingsVisibleGroups}"
					expandable="true"
				>
					<VBox items="{settings>/groups}">
						<CheckBox
							text="{settings>text}"
							selected="{settings>visible}"
						/>
					</VBox>
				</Panel>
				<Panel
					headerText="{i18n>settingsImportExport}"
					expandable="true"
				>
					<HBox wrap="Wrap">
						<Button
							text="{i18n>settingsExport}"
							icon="sap-icon://download"
							press=".onExport"
							class="sapUiSmallMarginEnd"
						/>
						<unified:FileUploader
							id="importFileUploader"
							buttonOnly="true"
							buttonText="{i18n>settingsImport}"
							icon="sap-icon://upload"
							fileType="json"
							sameFilenameAllowed="true"
							change=".onImportFileChange"
						/>
					</HBox>
				</Panel>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{i18n>save}"
				icon="sap-icon://save"
				type="Emphasized"
				press=".onSave"
			/>
		</beginButton>
		<endButton>
			<Button
				text="{i18n>cancel}"
				icon="sap-icon://decline"
				press=".onCancel"
			/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
