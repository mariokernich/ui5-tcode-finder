<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
>
	<Dialog
		id="welcomeDialog"
		title="{i18n>welcomeTitle}"
		contentWidth="32rem"
		draggable="true"
		afterClose=".onWelcomeDialogAfterClose"
	>
		<content>
			<VBox class="sapUiSmallMargin">
				<FormattedText htmlText="{i18n>welcomeText}" />
				<CheckBox
					id="welcomeDoNotShowAgain"
					text="{i18n>welcomeDoNotShowAgain}"
				/>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{i18n>close}"
				type="Emphasized"
				press=".onWelcomeDialogClose"
			/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>
