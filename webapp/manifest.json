{
	"_version": "2.8.0",

	"sap.app": {
		"id": "de.kernich.tcode",
		"type": "application",
		"i18n": {
			"bundleName": "de.kernich.tcode.i18n.i18n",
			"supportedLocales": ["", "de"],
			"fallbackLocale": ""
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "${version}"
		},
		"dataSources": {
			"standardTransactions": {
				"uri": "model/transactions.json",
				"type": "JSON"
			}
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"favIcon": "img/favicon.ico"
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"rootView": {
			"viewName": "de.kernich.tcode.view.App",
			"type": "XML",
			"id": "app"
		},

		"dependencies": {
			"minUI5Version": "1.148.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.ui.unified": {
					"lazy": true
				}
			}
		},

		"handleValidation": true,

		"contentDensities": {
			"compact": false,
			"cozy": true
		},

		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "de.kernich.tcode.i18n.i18n",
					"supportedLocales": ["", "de"],
					"fallbackLocale": ""
				}
			},
			"standardTransactions": {
				"type": "sap.ui.model.json.JSONModel",
				"dataSource": "standardTransactions"
			}
		},

		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "de.kernich.tcode.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "main",
					"target": "main"
				}
			],
			"targets": {
				"main": {
					"id": "main",
					"name": "Main"
				}
			}
		}
	}
}
