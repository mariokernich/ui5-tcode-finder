{
	"compilerOptions": {
		"target": "es2023",
		"module": "es2022",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"strict": true,
		"strictPropertyInitialization": false,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"rootDir": "./webapp",
		"types": ["@openui5/types", "qunit"],
		"paths": {
			"de/kernich/tcode/*": ["./webapp/*"],
			"unit/*": ["./webapp/test/unit/*"],
			"integration/*": ["./webapp/test/integration/*"]
		}
	},
	"include": ["./webapp/**/*"]
}
